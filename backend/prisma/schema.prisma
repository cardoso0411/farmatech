generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  ATTENDANT
}

enum SaleStatus {
  OPEN
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  CASH
  CREDIT_CARD
  DEBIT_CARD
  PIX
  INSURANCE
  OTHER
}

enum CustomerPersonType {
  INDIVIDUAL
  COMPANY
}

enum CustomerClassification {
  GOOD
  MEDIUM
  BAD
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
}

model User {
  id           String                @id @default(cuid())
  name         String
  email        String                @unique
  passwordHash String
  role         UserRole              @default(ATTENDANT)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  sales        Sale[]
  cashSessions CashRegisterSession[]
}

model Customer {
  id                    String                 @id @default(cuid())
  code                  Int                    @unique @default(autoincrement())
  personType            CustomerPersonType     @default(INDIVIDUAL)
  customerTypeId        String?
  customerType          CustomerType?          @relation(fields: [customerTypeId], references: [id])
  fullName              String?
  tradeName             String?
  legalName             String?
  cpf                   String?                @unique
  rg                    String?
  cnpj                  String?                @unique
  stateRegistration     String?
  email                 String?
  address               String?
  addressNumber         String?
  district              String?
  zipCode               String?
  city                  String?
  state                 String?
  phone                 String?
  mobilePhone           String?
  birthDate             DateTime?
  spcDate               DateTime?
  isBlocked             Boolean                @default(false)
  hasSubscription       Boolean                @default(false)
  classification        CustomerClassification @default(GOOD)
  sellerId              String?
  seller                Seller?                @relation(fields: [sellerId], references: [id])
  status                CustomerStatus         @default(ACTIVE)
  isSupplier            Boolean                @default(false)
  insuranceOnly         Boolean                @default(false)
  insurance             String?
  notes                 String?                @db.Text
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  sales                 Sale[]
}

model CustomerType {
  id          String     @id @default(cuid())
  name        String
  description String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[]
}

model Seller {
  id          String     @id @default(cuid())
  name        String
  code        String?    @unique
  email       String?
  phone       String?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  customers   Customer[]
}

model Product {
  id             String      @id @default(cuid())
  summary        String
  description    String
  barcode        String?     @unique
  categoryId     String?
  groupId        String?
  brand          String?
  sngpc          String?
  rms            String?
  presentation   String?
  reference      String?
  activeIngredient String?
  unit           String      @default("UN")
  dcb            String?
  packageQuantity Int?
  fractionQuantity Int?
  salePrice      Decimal     @db.Decimal(10, 2)
  costPrice      Decimal?    @db.Decimal(10, 2)
  stockQuantity  Int         @default(0)
  minimumStock   Int         @default(0)
  isGeneric      Boolean     @default(false)
  isControlled   Boolean     @default(false)
  isSpecial      Boolean     @default(false)
  isFractioned   Boolean     @default(false)
  isSimilar      Boolean     @default(false)
  ncmCode        String?
  pisList        String?
  origin         String?
  icms           String?
  saleOperation  String?
  observation    String?     @db.Text
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  category       ProductCategory? @relation(fields: [categoryId], references: [id])
  group          ProductGroup? @relation(fields: [groupId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]
}

model ProductCategory {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model ProductGroup {
  id            String    @id @default(cuid())
  local         String
  groupName     String
  sngpc         String
  saleOperation String
  code          String    @unique
  caution       String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  products      Product[]
}

model Sale {
  id             String       @id @default(cuid())
  saleNumber     Int          @unique @default(autoincrement())
  status         SaleStatus   @default(COMPLETED)
  subtotal       Decimal      @db.Decimal(10, 2)
  discountAmount Decimal      @default(0) @db.Decimal(10, 2)
  totalAmount    Decimal      @db.Decimal(10, 2)
  notes          String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  customerId     String?
  userId         String
  customer       Customer?    @relation(fields: [customerId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  items          SaleItem[]
  payments       Payment[]
}

model SaleItem {
  id          String   @id @default(cuid())
  quantity    Int
  unitPrice   Decimal  @db.Decimal(10, 2)
  discount    Decimal  @default(0) @db.Decimal(10, 2)
  totalPrice  Decimal  @db.Decimal(10, 2)
  saleId      String
  productId   String
  createdAt   DateTime @default(now())
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id])
}

model Payment {
  id         String        @id @default(cuid())
  method     PaymentMethod
  amount     Decimal       @db.Decimal(10, 2)
  reference  String?
  createdAt  DateTime      @default(now())
  saleId     String
  sale       Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model CashRegisterSession {
  id            String   @id @default(cuid())
  openingAmount Decimal  @db.Decimal(10, 2)
  closingAmount Decimal? @db.Decimal(10, 2)
  openedAt      DateTime @default(now())
  closedAt      DateTime?
  notes         String?  @db.Text
  userId        String
  user          User     @relation(fields: [userId], references: [id])
}

model StockMovement {
  id          String   @id @default(cuid())
  type        String
  quantity    Int
  reason      String?
  createdAt   DateTime @default(now())
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
}
